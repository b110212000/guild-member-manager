# Public client-side configuration. In GitHub Actions set repository Variables
# FEV_API_URL and FEV_GOOGLE_CLIENT_ID. Never use service-account secrets here.
VITE_FEV_API_URL=https://YOUR-WORKER-NAME.YOUR-ACCOUNT.workers.dev
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
